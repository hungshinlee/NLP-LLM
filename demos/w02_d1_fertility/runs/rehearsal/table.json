     "",
     "def get_pairs(corpus):\n    pairs = {}\n    for word, n in corpus.items():\n        syms = word.split()\n        for a, b in zip(syms, syms[1:]):\n            pairs[(a, b)] = pairs.get((a, b), 0) + n\n    return pairs\nprint(get_pairs({\"n e w\": 3, \"n e w e s t\": 5}))"
